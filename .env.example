# StarApp Configuration
# Server
HOST=127.0.0.1
PORT=8000
DEBUG=True
SECRET_KEY=starapp_super_secret_local_dev_key_2026_change_in_production
SESSION_EXPIRE_HOURS=24

# Database
DATABASE_URL=data/starapp.db

# External Integrations
# NOTE: Never commit production API keys to source control.
# Revoke and rotate any previously exposed Gemini keys in Google Cloud Console.
GEMINI_API_KEY=your_gemini_api_key_here

# --- Deployment hardening (see STARAPP_STAGE1_LOGIC_OPTIMIZATION_LOG.md) ---------------------------------
# true  = demo conveniences: passwordless quick-login pills, ?role=guardian shortcuts, header-based REST
#         identity, offline Pyodide bundle download, placeholder deliverables.
# false = REQUIRED for real users: every sign-in needs a password, those shortcuts are disabled.
STARAPP_DEMO_MODE=true
# In-memory UI sessions kept before the least-recently-used one is evicted (restored from a signed snapshot).
STARAPP_MAX_SESSIONS=1500
# Reload python modules on every request (development only). Defaults to the value of DEBUG.
STARAPP_HOT_RELOAD=true
# Comma-separated browser origins allowed to call the API with credentials.
STARAPP_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Mark the session cookie Secure when served over HTTPS.
STARAPP_COOKIE_SECURE=false
# NOTE: change SECRET_KEY above - it signs the browser session snapshots.
